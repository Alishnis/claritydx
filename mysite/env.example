# Django
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# AI chatbot / symptom NLP.
# Uses OpenRouter (https://openrouter.ai) by default so any OpenRouter model
# can be used via the OpenAI SDK; point OPENAI_BASE_URL back at
# https://api.openai.com/v1 with an sk-proj-... key to use OpenAI directly.
OPENAI_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=meta-llama/llama-3.1-8b-instruct

# Stripe (subscription payments)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# PostgreSQL (only used when running via docker-compose; leave unset
# for local development and Django will fall back to SQLite)
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# POSTGRES_DB=claritydx
# POSTGRES_USER=claritydx
# POSTGRES_PASSWORD=claritydx

# docker-compose only: host port the app is published on (default 8000)
# WEB_PORT=8000
